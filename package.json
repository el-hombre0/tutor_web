{
  "name": "tutor-platform",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:web": "pnpm --filter tutor-web dev",
    "build:web": "pnpm --filter tutor-web build",
    "lint:web": "pnpm --filter tutor-web lint",
    "dev:api": "pnpm --filter tutor-api start:dev",
    "build:api": "pnpm --filter tutor-api build",
    "lint:api": "pnpm --filter tutor-api lint",
    "test:api": "pnpm --filter tutor-api test",
    "test:e2e:api": "pnpm --filter tutor-api test:e2e"
  }
}
